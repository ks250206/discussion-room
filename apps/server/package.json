{
  "name": "@discussion-room/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "build": "vp pack src/main.ts --platform node",
    "start": "node dist/main.mjs",
    "test": "vp test",
    "spike:dev": "node --watch src/spikes/server-stack/main.ts",
    "spike:build": "vp pack src/spikes/server-stack/main.ts --platform node --out-dir dist-spike",
    "spike:start": "node dist-spike/main.mjs",
    "spike:room:dev": "node --watch src/spikes/room-roundtrip/main.ts",
    "spike:room:build": "vp pack src/spikes/room-roundtrip/main.ts --platform node --out-dir dist-room-spike",
    "spike:room:start": "node dist-room-spike/main.mjs",
    "spike:room:measure": "node src/spikes/room-roundtrip/measure.ts"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "hono": "catalog:",
    "valibot": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
